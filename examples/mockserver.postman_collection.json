{
  "info": {
    "_postman_id": "d9b9c0be-189b-4c56-9f78-4a2b2b5f7a10",
    "name": "Mockserver Local Debug",
    "description": "Import this collection into Postman to debug the local mockserver admin and runtime APIs. Default base_url is http://127.0.0.1:8080. If admin auth is disabled, leave admin_token empty.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "operator",
      "value": "postman-local",
      "type": "string"
    },
    {
      "key": "trace_id",
      "value": "postman-trace-001",
      "type": "string"
    },
    {
      "key": "ruleset_id",
      "value": "http-default",
      "type": "string"
    },
    {
      "key": "rule_id",
      "value": "debug-api",
      "type": "string"
    },
    {
      "key": "snapshot_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhook_url",
      "value": "https://postman-echo.com/post",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('trace_id')) {",
          "  pm.variables.set('trace_id', 'postman-' + Date.now());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is 2xx or expected mock miss', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 404]);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Draft Ruleset",
      "item": [
        {
          "name": "Upsert draft ruleset - template renderer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Mockserver-Operator",
                "value": "{{operator}}"
              },
              {
                "key": "X-Trace-ID",
                "value": "{{trace_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"http default\",\n  \"enabled\": true,\n  \"protocol\": \"http\",\n  \"namespace\": \"default\",\n  \"selector\": {\n    \"all\": [\n      {\n        \"field\": \"request.host\",\n        \"op\": \"eq\",\n        \"value\": \"demo.com\"\n      },\n      {\n        \"field\": \"request.path\",\n        \"op\": \"prefix\",\n        \"value\": \"/api/\"\n      }\n    ]\n  },\n  \"rules\": [\n    {\n      \"id\": \"{{rule_id}}\",\n      \"enabled\": true,\n      \"priority\": 100,\n      \"when\": {\n        \"all\": [\n          {\n            \"field\": \"request.method\",\n            \"op\": \"eq\",\n            \"value\": \"GET\"\n          },\n          {\n            \"field\": \"request.path\",\n            \"op\": \"eq\",\n            \"value\": \"/api/v1/debug\"\n          },\n          {\n            \"field\": \"request.query.q1[*]\",\n            \"op\": \"contains\",\n            \"value\": \"qv1\"\n          }\n        ]\n      },\n      \"action\": {\n        \"type\": \"respond\",\n        \"renderer\": \"template\",\n        \"response_template\": \"{\\\"status\\\":200,\\\"headers\\\":{\\\"content-type\\\":[\\\"application/json\\\"]},\\\"body\\\":{\\\"message\\\":\\\"hello {{ query . \\\"q1\\\" }}\\\",\\\"path\\\":\\\"{{ field . \\\"request.path\\\" }}\\\"}}\"\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/mockserver/api/v1/admin/rulesets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mockserver",
                "api",
                "v1",
                "admin",
                "rulesets"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('ruleset_id', json.data.id); }",
                  "pm.test('upsert success envelope', function () { pm.expect(json.code).to.eql(0); });"
                ]
              }
            }
          ]
        },
