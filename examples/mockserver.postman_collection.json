            "body": {
              "mode": "raw",
              "raw": "{\n  \"rule\": {\n    \"id\": \"static-api\",\n    \"name\": \"static api\",\n    \"enabled\": true,\n    \"priority\": 90,\n    \"when\": {\n      \"all\": [\n        {\n          \"field\": \"request.method\",\n          \"op\": \"eq\",\n          \"value\": \"GET\"\n        },\n        {\n          \"field\": \"request.path\",\n          \"op\": \"eq\",\n          \"value\": \"/api/v1/static\"\n        }\n      ]\n    },\n    \"action\": {\n      \"type\": \"respond\",\n      \"renderer\": \"static\",\n      \"response\": {\n        \"payload\": {\n          \"status\": 200,\n          \"headers\": {\n            \"content-type\": [\n              \"application/json\"\n            ]\n          },\n          \"body\": {\n            \"message\": \"static ok\"\n          }\n        }\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/mockserver/api/v1/admin/rulesets/{{ruleset_id}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
