            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"sequence-demo\",\n  \"name\": \"sequence demo\",\n  \"enabled\": true,\n  \"protocol\": \"http\",\n  \"namespace\": \"default\",\n  \"selector\": {\n    \"all\": [\n      {\n        \"field\": \"request.host\",\n        \"op\": \"eq\",\n        \"value\": \"demo.com\"\n      },\n      {\n        \"field\": \"request.path\",\n        \"op\": \"prefix\",\n        \"value\": \"/api/sequence\"\n      }\n    ]\n  },\n  \"rules\": [\n    {\n      \"id\": \"sequence-status\",\n      \"enabled\": true,\n      \"priority\": 100,\n      \"when\": {\n        \"field\": \"request.path\",\n        \"op\": \"eq\",\n        \"value\": \"/api/sequence/status\"\n      },\n      \"action\": {\n        \"type\": \"respond\",\n        \"renderer\": \"sequence\",\n        \"sequence_strategy\": \"last\",\n        \"sequence\": [\n          {\n            \"response\": {\n              \"payload\": {\n                \"status\": 200,\n                \"headers\": {\n                  \"content-type\": [\n                    \"application/json\"\n                  ]\n                },\n                \"body\": {\n                  \"state\": \"pending\",\n                  \"step\": 1\n                }\n              }\n            }\n          },\n          {\n            \"response\": {\n              \"payload\": {\n                \"status\": 200,\n                \"headers\": {\n                  \"content-type\": [\n                    \"application/json\"\n                  ]\n                },\n                \"body\": {\n                  \"state\": \"running\",\n                  \"step\": 2\n                }\n              }\n            }\n          },\n          {\n            \"response\": {\n              \"payload\": {\n                \"status\": 200,\n                \"headers\": {\n                  \"content-type\": [\n                    \"application/json\"\n                  ]\n                },\n                \"body\": {\n                  \"state\": \"done\",\n                  \"step\": 3\n                }\n              }\n            }\n          }\n        ]\n      }\n    }\n  ]\n}"
            },
